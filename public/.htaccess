# ---------------------------------------------------------------------------
# Spherotix — Apache / cPanel configuration for the React single-page app
# Upload the contents of the `dist/` folder (this file is copied there by the build).
# Replace spherotix.com with your real domain if it differs.
# ---------------------------------------------------------------------------

# Never list directories
Options -Indexes -MultiViews

# ---- Pretty error handling: let the React router render the 404 page -----
ErrorDocument 404 /index.html

# ---- Redirects & SPA routing ---------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0) Block hidden files (but allow /.well-known for SSL & verification)
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteRule (^|/)\.(?!htaccess) - [F,L]

  # 1) Force HTTPS (also works behind proxies / Cloudflare)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2) Canonical host: spherotix.com -> www.spherotix.com
  RewriteCond %{HTTP_HOST} ^spherotix\.com$ [NC]
  RewriteRule ^(.*)$ https://www.spherotix.com/$1 [R=301,L]

  # 3) Strip trailing "index.html" and trailing slashes (avoids duplicate URLs)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]

  # 4) Serve real files (assets, images, sitemap, robots …) directly
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # 5) Everything else is a client-side route -> index.html
  RewriteRule ^ /index.html [L]
</IfModule>

# ---- Security headers -----------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # Do not let HTML be cached for long, so deploys show up immediately
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Unhashed images (logo, project posters, icons): one week
  <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Hashed build output in /assets/ never changes: cache for a year
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Keep these fresh: they are not hashed
  <FilesMatch "^(sitemap\.xml|robots\.txt|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ---- Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/manifest+json image/svg+xml
</IfModule>

# ---- Browser caching fallback (when mod_headers is unavailable) -----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 week"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---- MIME types -----------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType application/javascript .js .mjs
</IfModule>
